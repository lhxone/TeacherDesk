generator client {
  provider      = "prisma-client-js"
  // Alpine/musl images must name their engine target explicitly. Without this
  // the CLI mis-detects openssl, looks for a plain `linux-musl` engine that is
  // not vendored, and tries to download one at container start.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String    @map("display_name") @db.VarChar(64)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(512)
  settings        Json      @default("{}")
  // Unique, permanent invite code every user is issued at registration; they
  // share it (via an invite link) so a new teacher can register. Never
  // regenerated once set.
  inviteCode      String    @unique @map("invite_code") @db.VarChar(16)
  // The user whose invite code this account registered with. Null for
  // accounts created with the bootstrap INITIAL_INVITE_CODE (i.e. no inviter).
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  invitedBy           User?                @relation("UserInvites", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitees            User[]               @relation("UserInvites")
  refreshTokens       RefreshToken[]
  classes             Class[]
  scheduleSlots       ScheduleSlot[]
  events              Event[]
  tags                Tag[]
  pushSubscriptions   PushSubscription[]
  sentReminders       SentReminder[]
  knowledgeNodes      KnowledgeNode[]
  resources           Resource[]
  resourceTags        ResourceTag[]
  resourceCollections ResourceCollection[]

  @@map("users")
}

// A browser/PWA Web Push endpoint (RFC 8030). One row per device+browser that
// opted in. `endpoint` is unique so re-subscribing the same browser updates the
// keys in place instead of piling up dead rows.
model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String    @db.VarChar(255)
  auth       String    @db.VarChar(255)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  label      String?   @db.VarChar(64)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Idempotency ledger for reminders. Lessons recur without a row per occurrence,
// so the scheduler records (userId, kind, refId, occursAt) after pushing and
// skips anything already here. Pruned once the occurrence is well in the past.
model SentReminder {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  kind     String   @db.VarChar(16)
  refId    String   @map("ref_id") @db.VarChar(64)
  occursAt DateTime @map("occurs_at") @db.Timestamptz(6)
  sentAt   DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId, occursAt])
  @@index([occursAt])
  @@map("sent_reminders")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  deviceInfo String?   @map("device_info") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model Class {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String    @db.VarChar(64)
  subject      String?   @db.VarChar(32)
  academicYear String    @map("academic_year") @db.VarChar(16)
  color        String    @default("#3B82F6") @db.VarChar(16)
  note         String?
  status       String    @default("active") @db.VarChar(16)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students       Student[]
  scheduleSlots  ScheduleSlot[]
  events         Event[]
  seatingCharts  SeatingChart[]
  examSessions   ExamSession[]
  exams          Exam[]
  lotteryRecords LotteryRecord[]
  groupingPlans  GroupingPlan[]

  @@index([userId, status])
  @@map("classes")
}

model Student {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  name      String    @db.VarChar(64)
  studentNo String?   @map("student_no") @db.VarChar(32)
  gender    String?   @db.VarChar(8)
  avatarUrl String?   @map("avatar_url") @db.VarChar(512)
  phone     String?   @db.VarChar(32)
  qq        String?   @db.VarChar(20)
  note      String?
  sortOrder Int       @default(0) @map("sort_order")
  status    String    @default("active") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentTags     StudentTag[]
  seatAssignments SeatAssignment[]
  scores          Score[]
  lotteryRecords  LotteryRecord[]
  groupMembers    GroupMember[]

  @@index([classId, status])
  @@map("students")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(32)
  color     String   @default("#10B981") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentTags  StudentTag[]
  resourceTags ResourceTag[]

  @@unique([userId, name])
  @@map("tags")
}

model StudentTag {
  studentId String   @map("student_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([studentId, tagId])
  @@map("student_tags")
}

model ScheduleSlot {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  classId    String?   @map("class_id") @db.Uuid
  subject    String?   @db.VarChar(32)
  weekday    Int       @db.SmallInt
  period     Int       @db.SmallInt
  location   String?   @db.VarChar(64)
  repeatRule String    @default("weekly") @map("repeat_rule") @db.VarChar(16)
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([userId, weekday])
  @@map("schedule_slots")
}

model Event {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  classId       String?   @map("class_id") @db.Uuid
  title         String    @db.VarChar(128)
  description   String?
  startAt       DateTime  @map("start_at") @db.Timestamptz(6)
  endAt         DateTime? @map("end_at") @db.Timestamptz(6)
  allDay        Boolean   @default(false) @map("all_day")
  // For a non-recurring event (repeatWeekday null) this is the one and only
  // completion flag. For a recurring one it's only the *template* default —
  // each week's actual completion lives in EventOccurrence instead (a row
  // only exists for a week that's been toggled away from that default; see
  // EventOccurrence's doc comment).
  isDone        Boolean   @default(false) @map("is_done")
  // Non-null (1 = Monday … 7 = Sunday) makes this a weekly-recurring todo
  // (e.g. "每周三值班"): startAt/endAt's time-of-day is reused every week from
  // startAt's date onward, and each occurrence's completion is tracked
  // independently via EventOccurrence.
  repeatWeekday Int?      @map("repeat_weekday") @db.SmallInt
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  occurrences EventOccurrence[]

  @@index([userId, startAt])
  @@map("events")
}

// Per-week completion override for a recurring Event (repeatWeekday
// non-null). Sparse by design, like SentReminder: a row exists only once a
// given week's occurrence has been toggled away from the event's own isDone
// default, so ticking one Wednesday doesn't touch any other week.
model EventOccurrence {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  // The occurrence's local calendar date (matches AgendaDay.date), not a
  // timestamp — one row per calendar day the recurring event lands on.
  occurrenceDate DateTime @map("occurrence_date") @db.Date
  isDone         Boolean  @default(false) @map("is_done")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceDate])
  @@map("event_occurrences")
}

model SeatingChart {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  name      String    @db.VarChar(64)
  rowCount  Int       @map("row_count") @db.SmallInt
  colCount  Int       @map("col_count") @db.SmallInt
  layout    Json      @default("{}")
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments SeatAssignment[]

  @@index([classId])
  @@map("seating_charts")
}

model SeatAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  seatingChartId String  @map("seating_chart_id") @db.Uuid
  studentId      String  @map("student_id") @db.Uuid
  rowIndex       Int     @map("row_index") @db.SmallInt
  colIndex       Int     @map("col_index") @db.SmallInt
  isPinned       Boolean @default(false) @map("is_pinned")

  seatingChart SeatingChart @relation(fields: [seatingChartId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([seatingChartId, rowIndex, colIndex])
  @@unique([seatingChartId, studentId])
  @@map("seat_assignments")
}

// A single exam occasion (考试批次) that a class sits, e.g. "第一次月考". Groups
// one or more per-subject Exam rows so the UI can create/list/manage the
// whole occasion at once while scoring and analytics stay keyed on the
// per-subject Exam as before.
model ExamSession {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  name      String    @db.VarChar(64)
  examType  String    @default("daily") @map("exam_type") @db.VarChar(16)
  examDate  DateTime  @map("exam_date") @db.Date
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  class Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  exams Exam[]

  @@index([classId, examDate])
  @@map("exam_sessions")
}

model Exam {
  id            String    @id @default(uuid()) @db.Uuid
  classId       String    @map("class_id") @db.Uuid
  examSessionId String    @map("exam_session_id") @db.Uuid
  name          String    @db.VarChar(64)
  subject       String?   @db.VarChar(32)
  examType      String    @default("daily") @map("exam_type") @db.VarChar(16)
  examDate      DateTime  @map("exam_date") @db.Date
  fullScore     Decimal   @default(100) @map("full_score") @db.Decimal(6, 2)
  note          String?
  statsCache    Json?     @map("stats_cache")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  class       Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  scores      Score[]

  @@index([classId, examDate])
  @@index([examSessionId])
  @@map("exams")
}

model Score {
  id        String   @id @default(uuid()) @db.Uuid
  examId    String   @map("exam_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  score     Decimal? @db.Decimal(6, 2)
  isAbsent  Boolean  @default(false) @map("is_absent")
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("scores")
}

model LotteryRecord {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  mode      String   @default("plain") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
  @@map("lottery_records")
}

model GroupingPlan {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  name      String    @db.VarChar(64)
  options   Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  class  Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  groups Group[]

  @@index([classId])
  @@map("grouping_plans")
}

model Group {
  id             String @id @default(uuid()) @db.Uuid
  groupingPlanId String @map("grouping_plan_id") @db.Uuid
  name           String @db.VarChar(64)
  groupIndex     Int    @map("group_index") @db.SmallInt

  groupingPlan GroupingPlan  @relation(fields: [groupingPlanId], references: [id], onDelete: Cascade)
  members      GroupMember[]

  @@map("groups")
}

model GroupMember {
  groupId   String @map("group_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
  @@map("group_members")
}

// ============================================================================
// 教学知识中心 (Teaching Knowledge Center)
// ============================================================================
//
// Resource is the single unified model for every kind of teaching material
// (textbook / ppt / lesson plan / image / mistake scan / other document).
// Type-specific behaviour (parsing, chunking) branches on `type` and `mimeType`
// in application code rather than via separate tables, so search, tagging,
// favorites, collections and knowledge-point linking all work uniformly
// across types (per the goal's "统一 Resource 模型" requirement).
//
// Full-text search is native Postgres pg_trgm — no Elasticsearch, no vector
// DB. Postgres's tsvector text-search configs (including 'simple') tokenize
// on Unicode word boundaries, which turns an entire run of Chinese
// characters into a single lexeme — substring queries against it never
// match, and true CJK segmentation needs a third-party parser extension
// (zhparser) that isn't in the stock postgres:15-alpine image. pg_trgm
// indexes character trigrams instead of words, so `ILIKE '%关键词%'` against
// resources.title/original_filename and resource_chunks.content is
// GIN-index-accelerated and scriptagnostic; see the migration for the
// extension + index DDL and routes/resources.ts for the query.
//
// Extensibility for future phases (question bank / QuestionAttempt / OCR /
// pgvector RAG) is designed in from the start:
//   - ResourceChunk is the natural unit to later attach an `embedding
//     vector(N)` column (pgvector) for RAG retrieval, and/or an
//     ocrText/ocrStatus pair for image OCR, without touching Resource.
//   - Resource.type having a 'mistake' variant plus `metadata` Json lets a
//     later 题库/错题 module store question stem, options and answer without
//     a schema migration; a dedicated Question/QuestionAttempt model can add
//     `resourceId` FKs back into this table when that phase starts.

model KnowledgeNode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String    @db.VarChar(128)
  subject   String?   @db.VarChar(32)
  grade     String?   @db.VarChar(32)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent            KnowledgeNode?          @relation("KnowledgeNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          KnowledgeNode[]         @relation("KnowledgeNodeTree")
  resourceKnowledge ResourceKnowledgeNode[]

  @@index([userId, parentId])
  @@map("knowledge_nodes")
}

model ResourceCollection {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String    @db.VarChar(128)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    ResourceCollection?  @relation("ResourceCollectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ResourceCollection[] @relation("ResourceCollectionTree")
  resources Resource[]

  @@index([userId, parentId])
  @@map("resource_collections")
}

// Free-form label reused across the app; StudentTag already links Tag to
// Student, ResourceTag links the same Tag rows to Resource so tag management
// (create/rename/delete, color) stays in one place (routes/tags.ts).
model ResourceTag {
  resourceId String   @map("resource_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId])
  @@map("resource_tags")
}

model ResourceKnowledgeNode {
  resourceId      String   @map("resource_id") @db.Uuid
  knowledgeNodeId String   @map("knowledge_node_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  resource      Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)

  @@id([resourceId, knowledgeNodeId])
  @@index([knowledgeNodeId])
  @@map("resource_knowledge_nodes")
}

model Resource {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // textbook / ppt / lesson_plan / image / mistake / document / other
  type    String  @db.VarChar(16)
  title   String  @db.VarChar(255)
  subject String? @db.VarChar(32)
  grade   String? @db.VarChar(32)
  note    String?

  collectionId String? @map("collection_id") @db.Uuid

  // Original filename as uploaded, kept for search/display even though the
  // file on disk is renamed to its id (see storagePath).
  originalFilename String  @map("original_filename") @db.VarChar(255)
  mimeType         String  @map("mime_type") @db.VarChar(128)
  fileSize         BigInt  @map("file_size")
  // Path is relative to the resources storage root (config.resourceStorageRoot),
  // never absolute — keeps the DB portable across hosts/containers.
  storagePath      String  @map("storage_path") @db.VarChar(512)
  // SHA-256 of the file content; lets a future upload short-circuit into
  // "already have this file" without re-parsing.
  checksum         String? @db.VarChar(64)

  // pending -> parsing -> ready | failed. Images/plain types that need no
  // extraction go straight to 'ready' on upload.
  status     String  @default("pending") @db.VarChar(16)
  parseError String? @map("parse_error")
  // Page count (PPT/PDF) or paragraph/section count (Word), when known.
  pageCount  Int?    @map("page_count")

  isFavorite Boolean   @default(false) @map("is_favorite")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  // Free-form extension point for future phases (e.g. mistake question stem/
  // options/answer, OCR status) without another migration.
  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection ResourceCollection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  chunks     ResourceChunk[]
  tags       ResourceTag[]
  knowledge  ResourceKnowledgeNode[]

  @@index([userId, type, status])
  @@index([userId, collectionId])
  @@index([userId, isFavorite])
  @@index([userId, lastUsedAt])
  @@map("resources")
}

// One row per page (PPT/PDF) or section/paragraph-group (Word) of extracted
// text, so a search hit can be pointed back at "第 12 页" / "第 3 章" instead
// of just the parent file. `embedding` for pgvector-based RAG retrieval is a
// deliberately-deferred future column on this same table (see header note).
model ResourceChunk {
  id         String @id @default(uuid()) @db.Uuid
  resourceId String @map("resource_id") @db.Uuid

  // Ordinal position within the resource, 0-based, used for stable ordering
  // regardless of how pageNumber/sectionLabel are formatted.
  ordinal      Int     @db.Integer
  // PPT/PDF page number (1-based) when applicable.
  pageNumber   Int?    @map("page_number")
  // Word heading / chapter title, or a short auto-generated label, when
  // applicable ("第一章 有理数").
  sectionLabel String? @map("section_label") @db.VarChar(255)
  content      String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, ordinal])
  @@index([resourceId, pageNumber])
  @@map("resource_chunks")
}
