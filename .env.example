# Copy to .env next to docker-compose.yml and fill in real values.
#   cp .env.example .env
# Never commit the filled-in .env.

# Application image tag published by GitHub Actions. Use a release tag such as
# v1.0.0 in production for reproducible deployments; `latest` follows main.
TEACHERDESK_IMAGE_TAG=latest

# ---- database ----
POSTGRES_USER=teacherdesk
POSTGRES_DB=teacherdesk
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# ---- api ----
# Generate: openssl rand -base64 48
# Changing this invalidates every existing login.
JWT_SECRET=CHANGE_ME

# Cost factor for password hashing. 12 is a good default; lower only if your
# NAS CPU makes logins noticeably slow.
BCRYPT_ROUNDS=12

# Bootstrap invite code, only usable to register the very first account (the
# users table must be empty). Registration always requires an invite code —
# every account after the first gets its own permanent one to share, so this
# value is only needed once and doesn't need to stay in a production .env
# after that first account exists.
INITIAL_INVITE_CODE=

# ---- web push (course / todo reminders) ----
# Generate once: cd server && npx web-push generate-vapid-keys
# Leave both blank to disable push entirely (the app still runs).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI required by the push spec; a mailto: you own.
VAPID_SUBJECT=mailto:admin@teacherdesk.app
# Fallback timezone (minutes east of UTC; 480 = UTC+8), used only for a user
# who has no `settings.timeZone` (an IANA name, e.g. "Asia/Shanghai") set.
# Each teacher's own timezone is stored per-user and takes priority — this app
# is public and teachers can be anywhere, so lesson-reminder times must never
# be computed from one server-wide zone.
LOCAL_TZ_OFFSET_MINUTES=480

# ---- weather (home page forecast) ----
# The home-page weather card fetches from Open-Meteo (https://api.open-meteo.com),
# which is free and needs no API key — there is nothing to configure here. The
# only requirement is that the api container can reach that host on egress; if it
# can't, the card just stays hidden.

# ---- public site ----
PUBLIC_ORIGIN=https://t-desk.buildlink.cc

# ---- cloudflare tunnel ----
# Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> install token.
# The long token string from the `cloudflared ... run --token <TOKEN>` command.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME
